# Copy to .env.local for local overrides. In production set these in Vercel > Settings > Environment Variables.
# Anything left empty is hidden on the site (nothing is invented).
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# International format, digits only, e.g. 2348012345678
VITE_WHATSAPP_NUMBER=
VITE_STORE_LOCATION=Lagos, Nigeria
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_TWITTER_URL=
# Shown in the cart and after checkout. Say how the customer pays.
VITE_PAYMENT_NOTE=We'll email you payment and delivery details after you place your order.
# Set to true only when you have real customer reviews to show.
VITE_SHOW_REVIEWS=false
